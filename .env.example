# Admin gate password. Client-side only — visible in the shipped bundle, so treat it
# as an obscurity layer, not real security (real auth is on the backlog).
# Set the same variable in Vercel project settings for deployed environments.
VITE_ADMIN_PASSWORD=

# Stripe Payment Link for the $500 booking deposit. Create a fixed-amount
# Payment Link in the Stripe dashboard and paste the URL here. When unset, the
# booking page shows "a deposit link is sent with your confirmation" instead.
VITE_STRIPE_DEPOSIT_URL=

# Tenant portal access codes, one per unit (10 and 12 chemin du Mont Echo).
# Client-side gate like the admin one. Set both here and in Vercel.
VITE_TENANT_CODE_10=
VITE_TENANT_CODE_12=
